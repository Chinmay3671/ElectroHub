{
  "info": {
    "_postman_id": "electrohub-mini-project-api-v1",
    "name": "ElectroHub - Electronics Shopping Mini Project",
    "description": "Postman API Collection for ElectroHub Advanced Java Spring Boot Mini Project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "1. Add Product (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arduino Nano Every\",\n  \"category\": \"Microcontrollers\",\n  \"price\": 14.50,\n  \"description\": \"Compact 5V Arduino board based on the ATMega4809 processor with 48KB Flash memory.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Adds a new electronic product to the catalog."
          }
        },
        {
          "name": "2. Get All Products (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Retrieves all products from the catalog."
          }
        },
        {
          "name": "3. Get Product By ID (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Retrieves a single product by its ID."
          }
        }
      ]
    },
    {
      "name": "Shopping Cart",
      "item": [
        {
          "name": "1. Add Item to Cart (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items"]
            },
            "description": "Adds an electronic product to the shopping cart."
          }
        },
        {
          "name": "2. View All Cart Items (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items"]
            },
            "description": "Retrieves all items currently in the shopping cart."
          }
        },
        {
          "name": "3. Calculate Cart Total (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/total",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "total"]
            },
            "description": "Calculates the total quantity, distinct count, and grand total price of all cart items."
          }
        },
        {
          "name": "4. Remove Cart Item By ID (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items", "1"]
            },
            "description": "Removes a specific item from the cart."
          }
        },
        {
          "name": "5. Clear All Cart Items (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items"]
            },
            "description": "Clears all items from the shopping cart."
          }
        }
      ]
    },
    {
      "name": "External Resources",
      "item": [
        {
          "name": "1. Get All Resources (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources"]
            },
            "description": "Returns all external resources and documentation links."
          }
        },
        {
          "name": "2. Get C Compiler Resource (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/c-compiler",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "c-compiler"]
            },
            "description": "Returns Embedded C online compiler & debugger link."
          }
        },
        {
          "name": "3. Get Simulation Resource (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/simulation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "simulation"]
            },
            "description": "Returns Wokwi electronics simulator link."
          }
        },
        {
          "name": "4. Get Circuit Simulation Resource (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/circuit-simulation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "circuit-simulation"]
            },
            "description": "Returns Autodesk Tinkercad Circuits simulation link."
          }
        },
        {
          "name": "5. Get Component Info Resource (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/component-info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "component-info"]
            },
            "description": "Returns Wikipedia electronic components encyclopedia link."
          }
        },
        {
          "name": "6. Get Project Files (Google Drive) (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/project-files",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "project-files"]
            },
            "description": "Returns Google Drive shareable URL for project source files."
          }
        },
        {
          "name": "7. Get Documentation (Google Drive) (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources/documentation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "documentation"]
            },
            "description": "Returns Google Drive shareable URL for project documentation."
          }
        }
      ]
    }
  ]
}
